# Extra environment for paper-agent-team-backup.service (systemd timer).
#
# curl reads the complete Authorization header from a root-only file (curl -H @file), so the admin token never
# appears in the unit, in this file, or in the process list. Create it from the admin token that
# hash-token.ts printed during initial setup (README section 5), and never commit it:
#   printf 'Authorization: Bearer %s\n' "$(sudo cat /root/paper-agent-team-admin.token)" \
#     | sudo install -m 600 /dev/stdin /etc/paper-agent-team/admin.header
PAPER_AGENT_TEAM_ADMIN_HEADER_FILE=/etc/paper-agent-team/admin.header
PAPER_AGENT_TEAM_CA_FILE=/etc/paper-agent-team/tls/ca.crt
# Namespace to snapshot; must already exist on the server.
PAPER_AGENT_TEAM_BACKUP_NAMESPACE=lab
